# Map generation API keys
# Copy this file to .env.local and add your API keys

# Stadia Maps API key (required for stadiaWaterColor and other Stadia providers)
# Get your free API key from: https://client.stadiamaps.com/signup/
STADIA_MAPS_API_KEY=your_api_key_here

# Note: If you don't have a Stadia API key, you can change CHOSEN_PROVIDER 
# in scripts/import-data/maps.ts to use a free provider like:
# - "openstreetmap"
# - "carto"
# - "cartoPositron"
# - "cartoDarkMatter"