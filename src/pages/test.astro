---
import Container from "@/components/Common/Container";
import PageLayout from "@/layouts/PageLayout.astro";
import { getEvents } from "@/content";
import EventEntryCard from "@/components/Event/EventEntryCard";

// Get all events and select some random ones from the past
const allEvents = await getEvents();
const selectedIndices = [4, 8, 12, 16, 20, 25, 30, 35, 40, 45, 50, 55, 60, 65]; // 14 events for variety
const events = selectedIndices.map((index) => allEvents[index]).filter(Boolean); // Filter out any undefined if index is out of bounds
---

<PageLayout>
  <Container>
    <div class="py-10 space-y-10">
      <h2 class="text-2xl font-bold">Preset Combinations</h2>
      <p class="text-sm text-base-content/70">
        All 6 predefined presets alternating between up-down and down-up patterns
      </p>

      <div class="space-y-6">
        <div class="border-2 border-primary p-4 rounded">
          <h3 class="font-bold mb-2">Preset 0: Classic Trifold</h3>
          <p class="text-xs mb-4">Pattern: ↑↓↑↓</p>
          <p class="text-xs mb-4">seam1: -22°, seam2: -26°, rotX: +10°, rotY: -12°, rotZ: +1°</p>
          <div class="w-full mx-auto">
            <EventEntryCard event={events[0]} client:load presetIndex={0} />
          </div>
        </div>

        <div class="border-2 border-primary p-4 rounded">
          <h3 class="font-bold mb-2">Preset 1: Dynamic Wave</h3>
          <p class="text-xs mb-4">Pattern: ↓↑↓↑</p>
          <p class="text-xs mb-4">seam1: +24°, seam2: +28°, rotX: +8°, rotY: +11°, rotZ: -2°</p>
          <div class="w-full mx-auto">
            <EventEntryCard event={events[0]} client:load presetIndex={1} />
          </div>
        </div>

        <div class="border-2 border-primary p-4 rounded">
          <h3 class="font-bold mb-2">Preset 2: Dramatic Fan</h3>
          <p class="text-xs mb-4">Pattern: ↑↓↑↓</p>
          <p class="text-xs mb-4">seam1: -28°, seam2: -32°, rotX: +12°, rotY: -15°, rotZ: +2°</p>
          <div class="w-full mx-auto">
            <EventEntryCard event={events[0]} client:load presetIndex={2} />
          </div>
        </div>

        <div class="border-2 border-primary p-4 rounded">
          <h3 class="font-bold mb-2">Preset 3: Subtle Twist</h3>
          <p class="text-xs mb-4">Pattern: ↓↑↓↑</p>
          <p class="text-xs mb-4">seam1: +20°, seam2: +23°, rotX: +6°, rotY: +10°, rotZ: -1°</p>
          <div class="w-full mx-auto">
            <EventEntryCard event={events[0]} client:load presetIndex={3} />
          </div>
        </div>

        <div class="border-2 border-primary p-4 rounded">
          <h3 class="font-bold mb-2">Preset 4: Bold Statement</h3>
          <p class="text-xs mb-4">Pattern: ↑↓↑↓</p>
          <p class="text-xs mb-4">seam1: -25°, seam2: -30°, rotX: +11°, rotY: -13°, rotZ: +1°</p>
          <div class="w-full mx-auto">
            <EventEntryCard event={events[0]} client:load presetIndex={4} />
          </div>
        </div>

        <div class="border-2 border-primary p-4 rounded">
          <h3 class="font-bold mb-2">Preset 5: Gentle Flow</h3>
          <p class="text-xs mb-4">Pattern: ↓↑↓↑</p>
          <p class="text-xs mb-4">seam1: +21°, seam2: +25°, rotX: +9°, rotY: +8°, rotZ: 0°</p>
          <div class="w-full mx-auto">
            <EventEntryCard event={events[0]} client:load presetIndex={5} />
          </div>
        </div>
      </div>

      <hr class="my-12 border-base-300" />

      <h2 class="text-2xl font-bold">Random Seed Examples</h2>
      <p class="text-sm text-base-content/70">
        Different seeds showing both up-down-up-down and down-up-down-up patterns
      </p>
      <div class="space-y-4">
        <div class="border-2 border-secondary p-4 rounded">
          <h3 class="font-bold mb-2">Seed: "tokyo-2024"</h3>
          <div class="w-full mx-auto">
            <EventEntryCard event={events[1]} client:load seedId="tokyo-2024" />
          </div>
        </div>
        <div class="border-2 border-secondary p-4 rounded">
          <h3 class="font-bold mb-2">Seed: "conference-xyz"</h3>
          <div class="w-full mx-auto">
            <EventEntryCard event={events[1]} client:load seedId="conference-xyz" />
          </div>
        </div>
        <div class="border-2 border-secondary p-4 rounded">
          <h3 class="font-bold mb-2">Seed: "event#42"</h3>
          <div class="w-full mx-auto">
            <EventEntryCard event={events[1]} client:load seedId="event#42" />
          </div>
        </div>
        <div class="border-2 border-secondary p-4 rounded">
          <h3 class="font-bold mb-2">Seed: "meetup-osaka"</h3>
          <div class="w-full mx-auto">
            <EventEntryCard event={events[1]} client:load seedId="meetup-osaka" />
          </div>
        </div>
        <div class="border-2 border-secondary p-4 rounded">
          <h3 class="font-bold mb-2">Seed: "workshop@2025"</h3>
          <div class="w-full mx-auto">
            <EventEntryCard event={events[1]} client:load seedId="workshop@2025" />
          </div>
        </div>
        <div class="border-2 border-secondary p-4 rounded">
          <h3 class="font-bold mb-2">Seed: "hackathon!"</h3>
          <div class="w-full mx-auto">
            <EventEntryCard event={events[1]} client:load seedId="hackathon!" />
          </div>
        </div>
      </div>

      <hr class="my-12 border-base-300" />

      <h2 class="text-2xl font-bold">Event Entry Cards</h2>
      <div class="space-y-12">
        {
          events.slice(5).map((event, index) => (
            <div class="w-full  mx-auto">
              <EventEntryCard event={event} client:load />
            </div>
          ))
        }
      </div>
    </div>
  </Container>
</PageLayout>
