---
import { getCollection, getEntry, render } from "astro:content";
import VenueInfo from "@/components/Venue/VenueInfo";
import VenueNav from "@/components/Venue/VenueNav";
import EventFeatured from "@/components/Event/EventFeatured";
import PageLayout from "@/layouts/PageLayout.astro";
import StickyNavigation from "@/components/Common/StickyNavigation";
import Section from "@/components/Common/Section";
import { getVenue, getVenues, getEvents } from "@/content";

export async function getStaticPaths() {
  const venues = await getCollection("venues");

  // Only create pages for venues with hasPage: true
  const venuePaths = venues
    .filter((venue) => venue.data.hasPage)
    .map((venue) => ({
      params: { venueSlug: venue.id },
    }));

  return venuePaths;
}

const { venueSlug } = Astro.params;
const venue = await getVenue(venueSlug);
const venues = await getVenues();
const allEvents = await getEvents();
const venueEvents = allEvents.filter(
  (event) => event.data.venue?.id === venue.data.meetupId.toString(),
);

// Get markdown content
let Content: any = null;
try {
  const markdownFile = await getEntry("venuesMarkdown", venueSlug);
  if (markdownFile) {
    const rendered = await render(markdownFile);
    Content = rendered.Content;
  }
} catch (e) {
  // No markdown file found, which is fine
}

// Create description
const description =
  venue.data.description ||
  `${venue.data.title} - Event venue in ${venue.data.city || "Osaka"}. ${venueEvents.length} events hosted.`;
---

<PageLayout title={`${venue.data.title} - Venues`} description={description}>
  <Section>
    <div class="flex flex-col gap-12 lg:flex-row">
      <div class="flex flex-1 flex-col gap-10">
        {
          venue.data.cover && (
            <figure class="aspect-video w-full overflow-hidden rounded-xl bg-white shadow-xl">
              <img
                src={venue.data.cover.src}
                alt={`${venue.data.title} cover`}
                class="h-full w-full object-contain p-8"
                width={512}
                height={512}
              />
            </figure>
          )
        }

        <h1 class="pt-6 text-4xl font-bold" data-testid="venue-title-page">{venue.data.title}</h1>

        {
          Content && (
            <div class="prose prose-lg max-w-none">
              <Content />
            </div>
          )
        }
      </div>

      <div class="lg:w-80">
        <div class="lg:sticky lg:top-20">
          <div class="card bg-base-100 overflow-hidden rounded-lg shadow-lg">
            <div class="card-body p-0">
              <VenueInfo venue={venue} />
            </div>
          </div>
        </div>
      </div>
    </div>
  </Section>

  {
    venueEvents.length > 0 && (
      <Section>
        <h2 class="mb-8 text-2xl font-bold">Events Hosted at {venue.data.title}</h2>
        <div class="flex flex-col gap-8">
          {venueEvents.map((event) => (
            <EventFeatured event={event} hideMap={true} />
          ))}
        </div>
      </Section>
    )
  }

  <Section>
    <VenueNav
      venue={venue}
      venues={venues}
      className="venue-navigation"
      keyboardEvents
      client:load
    />
  </Section>

  <StickyNavigation navigationClass="venue-navigation" client:load>
    <VenueNav venue={venue} venues={venues} keyboardEvents />
  </StickyNavigation>
</PageLayout>
