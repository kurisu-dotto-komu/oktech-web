---
import PageLayout from "@/layouts/PageLayout.astro";
import ImagePlaceholder from "@/components/Common/ImagePlaceholder";
import Section from "@/components/Common/Section";
import SocialsBig from "@/components/Common/SocialsBig";
import LandingHero from "@/components/Landing/LandingHero";
---

<PageLayout
  title="About"
  description="Learn about OKTech - Osaka Kyoto Tech Meetup Group. Our mission is to build a thriving tech community through events, workshops, and networking opportunities. Discover our history and how to get involved."
>
  <LandingHero client:load />
  <Section
    split
    title="Our Mission"
    description="OKTech brings together the best of both worlds – the innovation of Osaka and the tradition of Kyoto – in one dynamic tech community. We believe great code and great friendships go hand in hand. Whether you're debugging React hooks or exploring the latest in AI, you'll find kindred spirits here. Our events mix technical deep-dives with genuine human connection, because we know the best solutions come from diverse perspectives shared over good conversation."
  >
    <ImagePlaceholder />
  </Section>
  <Section
    split
    title="Our Story"
    description="What started as casual coffee chats between developers has grown into Kansai's most welcoming tech community. The 'OK' in OKTech isn't just our cities – it's our philosophy. We're OK with all skill levels, OK with making mistakes, and definitely OK with staying late to help debug that one weird issue. Our volunteer-driven community thrives on the energy of members who step up to share, teach, and learn together. From cherry blossom coding sessions to hiking brainstorms, we blend tech with the unique culture of our region."
    left
    ><ImagePlaceholder />
  </Section>
  <Section
    anchor="contact"
    title="Get Involved"
    description="Whether you are looking to become a speaker, sponsor or just want to get involved, we are always looking for new people to join our community!"
    class="text-center"
    wide
  >
    <SocialsBig />
  </Section>
</PageLayout>
