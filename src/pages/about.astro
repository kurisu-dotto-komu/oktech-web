---
import PageLayout from "@/layouts/PageLayout.astro";
import SocialsBig from "@/components/Common/SocialsBig";
import { Icon } from "astro-icon/components";

import Container from "@/components/Common/Container";
import BlobSlideshow from "@/components/Common/BlobSlideshow.astro";
import { BLOBS } from "@/utils/blobs";
import ContentSection from "@/components/Common/ContentSectiont";
import Cut from "@/components/Common/Cut";
---

<PageLayout
  title="About"
  description="Learn about OKTech - Osaka Kyoto Tech Meetup Group. Our mission is to build a thriving tech community through events, workshops, and networking opportunities. Discover our history and how to get involved."
  flush
>
  <div class="bg-base-200 py-24 pt-42">
    <Container>
      <div
        class="m-auto flex max-w-3xl flex-col gap-12 text-center leading-relaxed text-pretty md:gap-18"
      >
        <h1 class="text-5xl font-bold">About OKTech</h1>
        <p class="text-2xl">
          OKTech is a volunteer-run, non-profit group that organizes monthly English in-person
          technology meetups in Japan's Kansai region.
        </p>
        <div class="flex flex-col gap-12 text-lg sm:flex-row md:gap-24 md:text-justify">
          <p>
            We welcome people from all backgrounds and encouraging members to share topics they’re
            passionate about. Join us in Osaka and Kyoto for technical workshops, study sessions,
            and social gatherings.
          </p>
          <p>
            オーケーテックは、関西地域で毎月対面の技術系ミートアップを開催するボランティアによる非営利団体で、誰でも参加可能であり、発表や交流を通じて学び合う場を提供しています。
          </p>
        </div>
      </div>
    </Container>
  </div>
  <ContentSection
    reverse
    title="Join in"
    text="The first step is to come to an event and meet people! We're a friendly bunch and we're always happy to meet new people. Our events are the core experience of OKTech. "
    button={{ text: "Find an Event", href: "/events" }}
  >
    <BlobSlideshow
      blobs={[BLOBS[2], BLOBS[0], BLOBS[4], BLOBS[5], BLOBS[7], BLOBS[1]]}
      images={[
        "/content/events/299334647-workshop-create-a-blogportfolio-in-astro-and-hygraph/gallery/IMG_9847.webp",
        "/content/events/299334647-workshop-create-a-blogportfolio-in-astro-and-hygraph/gallery/IMG_9823.webp",
        "/content/events/299334647-workshop-create-a-blogportfolio-in-astro-and-hygraph/gallery/IMG_9751.webp",
      ]}
    />
  </ContentSection>

  <Cut bgClass="bg-secondary/40">
    <ContentSection
      title="Become a Speaker"
      text="Practice. And Benefit and help raise your profile. Practice. And Benefit and help raise your profile. Practice. And Benefit and help raise your profile."
      button={{
        text: "Submit a Talk",
        href: "/events/submit-a-talk",
        className: "btn-secondary btn-lg",
      }}
    >
      <BlobSlideshow
        blobs={[BLOBS[2], BLOBS[0], BLOBS[4], BLOBS[5], BLOBS[7]]}
        images={[
          "/content/events/298753297-how-to-get-into-tech-part-2/gallery/IMG_3840.webp",
          "/content/events/305451315-rights-and-unions/gallery/PXL_20250419_0930442362.webp",
          "/content/events/307265699-led-and-vulnerability-disclosure/gallery/PXL_20250524_0820206402.webp",
          "/content/events/302750416-key-to-resume/gallery/IMG_20240907_1732152.webp",
          "/content/events/301456891-workshop-like-s3/gallery/IMG_7679.webp",
        ]}
      />
    </ContentSection>
  </Cut>
  <ContentSection
    reverse
    title="Volunteer"
    text=`OKTech operates as a transparent, community-driven organization. While we have organizers who
    handle the logistics and final decisions, every volunteer has a voice in shaping our
      direction.
    </p>
    <p>
      We discuss ideas openly, work collaboratively, and believe the best communities are built by
      the people who show up. Want to help organize an event, suggest a workshop theme, or bring
      OKTech to the next level?`
    reverse
  >
    <BlobSlideshow
      blobs={[BLOBS[2], BLOBS[0], BLOBS[4], BLOBS[5], BLOBS[7]]}
      images={[
        "/content/events/298753297-how-to-get-into-tech-part-2/gallery/IMG_3840.webp",
        "/content/events/305451315-rights-and-unions/gallery/PXL_20250419_0930442362.webp",
        "/content/events/307265699-led-and-vulnerability-disclosure/gallery/PXL_20250524_0820206402.webp",
        "/content/events/302750416-key-to-resume/gallery/IMG_20240907_1732152.webp",
        "/content/events/301456891-workshop-like-s3/gallery/IMG_7679.webp",
      ]}
    />
  </ContentSection>
  <Cut>
    <ContentSection title="OK History">
      <div class="prose prose-lg grid max-w-none grid-cols-1 gap-16 md:grid-cols-2">
        <div>
          <p>
            Orignally, OKTech was started 2015 as a Web Development Meetup Group in Osaka, called
            OWDDM. A Kyoto sister group was started called KWDDM.
          </p>
          <p>IN 2025</p>
        </div>
        <div>
          <p>TODO</p>
        </div>
      </div>
    </ContentSection>
  </Cut>

  <ContentSection title="Connect">
    <SocialsBig />
  </ContentSection>
</PageLayout>
