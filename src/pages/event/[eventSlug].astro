---
import { getEvents, getEvent } from "@/content";
import fs from "fs/promises";
import path from "path";
import yaml from "yaml";
import EventNav from "@/components/Event/EventNav";
import EventLinks from "@/components/Event/EventLinks";
import EventGallery from "@/components/Event/EventGallery";
import type { EventLink } from "@/components/Event/EventLinks";
import PageLayout from "@/layouts/PageLayout.astro";
import StickyNavigation from "@/components/Common/StickyNavigation";
import Section from "@/components/Common/Section";
import EventInfo from "@/components/Event/EventInfo";
import EventJoinButton from "@/components/Event/EventJoinButton";
import EventProjectorButton from "@/components/Event/EventProjectorButton";
import AddToCalendarDropdown from "@/components/Event/EventCalendarDropdown";
import HowToFindUs from "@/components/Event/EventHowToFindUs";
import { getEntry, render } from "astro:content";

export async function getStaticPaths() {
  const events = await getEvents();

  return events.map(({ id }) => {
    return {
      params: { eventSlug: id },
    };
  });
}

const { eventSlug } = Astro.params;
const event = await getEvent(eventSlug);
const events = await getEvents();

const markdownFile = await getEntry("eventsMarkdown", eventSlug);
if (!markdownFile) {
  throw new Error(`Event ${eventSlug} not found`);
}
const { Content } = await render(markdownFile);

// Load links for this event
let links: EventLink[] = [];
try {
  const linksPath = path.join(process.cwd(), "content", "events", event.id, "links.yaml");
  const linksContent = await fs.readFile(linksPath, "utf-8");
  links = yaml.parse(linksContent) as EventLink[];
} catch (error) {
  // No links.yaml file found for this event
}

// Get topics as a description
const description = event.data.topics?.length
  ? `Topics: ${event.data.topics.join(", ")}`
  : "Join us for this exciting tech meetup event!";
---

<PageLayout title={`${event.data.title} - Events`} description={description} type="article">
  <Section>
    <div class="w-full flex flex-col gap-8">
      <div class="md:hidden flex flex-col gap-10">
        <h1 class="text-4xl font-bold pt-6" data-testid="event-title">{event.data.title}</h1>
        <EventInfo event={event} />
        <EventJoinButton event={event} client:load />
        <AddToCalendarDropdown event={event} client:load />
      </div>

      <div class="flex flex-col md:flex-row gap-12">
        <div class="md:w-2/3 flex flex-col gap-10">
          <div class="relative group">
            <div class="absolute top-2 right-2">
              <EventProjectorButton event={event} client:load />
            </div>
            <figure class="rounded-xl aspect-video w-full bg-base-300 shadow-xl overflow-hidden">
              {
                event.data.cover ? (
                  <img
                    src={event.data.cover.src}
                    alt={event.data.title}
                    class="w-full h-full object-cover"
                    width={512}
                    height={512}
                  />
                ) : (
                  <div class="w-full h-full bg-base-300" />
                )
              }
            </figure>
          </div>
          <h1 class="hidden md:block text-4xl font-bold pt-6" data-testid="event-title-desktop">
            {event.data.title}
          </h1>
          <div class="max-w-none prose prose-lg">
            <Content />
          </div>
        </div>
        <div class="hidden md:block md:w-1/3 sticky top-20 self-start pl-8">
          <div class="flex flex-col gap-8 overflow-visible">
            <div class="card bg-base-100 shadow-lg rounded-lg overflow-visible relative">
              <div class="card-body p-0 overflow-visible">
                <EventInfo event={event} />
              </div>
            </div>
            <EventJoinButton event={event} client:load />
            <AddToCalendarDropdown event={event} client:load />
          </div>
        </div>
      </div>
    </div>
  </Section>
  <EventLinks links={links} />
  <EventGallery event={event} client:load />
  <Section>
    <EventNav
      event={event}
      events={events}
      className="event-navigation"
      keyboardEvents
      client:load
    />
  </Section>
  <StickyNavigation navigationClass="event-navigation" client:load>
    <EventNav event={event} events={events} />
  </StickyNavigation>
</PageLayout>
