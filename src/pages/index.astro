---
import SimpleSection from "@/components/Common/SimpleSection";
import EventsUpcoming from "@/components/Events/EventsUpcoming";
import EventsRecent from "@/components/Events/EventsRecent";
import PageLayout from "@/layouts/PageLayout.astro";
import LandingHero from "@/components/Landing/LandingHero.astro";
import LandingAbout from "@/components/Landing/LandingAbout.astro";
import GetInvolved from "@/components/Landing/GetInvolved";
import { getEvents } from "@/content";

const events = await getEvents();
---

<PageLayout flush className="flex flex-col gap-24 pb-24">
  <LandingHero />

  <SimpleSection title="Upcoming Events">
    <EventsUpcoming client:load events={events} />
  </SimpleSection>

  <LandingAbout />

  <SimpleSection title="Recent Events" wide button={{ text: "All Events", href: "/events" }}>
    <EventsRecent events={events} />
  </SimpleSection>

  <SimpleSection title="Get Involved (TODO)">
    <GetInvolved client:load />
  </SimpleSection>
</PageLayout>
