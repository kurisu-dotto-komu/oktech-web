---
import Section from "@/components/Common/Section";
import Hero from "@/components/Common/Hero";
import EventSummary from "@/components/Event/EventSummary";
import LandingStats from "@/components/Common/LandingStats";
import EventsUpcoming from "@/components/Events/EventsUpcoming";
import ImagePlaceholder from "@/components/Common/ImagePlaceholder";
import PersonAvatars from "@/components/Person/PersonAvatars";
import Banner from "@/components/Common/Banner";
import PageLayout from "@/layouts/PageLayout.astro";
import { getEvents, getPeople } from "@/content";
import Brand from "@/components/Common/Brand";

const events = await getEvents();
const people = await getPeople();
---

<PageLayout
  description="Join the Osaka Kyoto Tech Meetup Group (OKTech) - A vibrant community for web developers, designers, and tech enthusiasts. Discover upcoming events, workshops, and networking opportunities in the Kansai region."
>
  <Banner />
  <Hero shader client:load>
    <div class="flex flex-col gap-20">
      <Brand big />
      <div class="bg-base-100/50 w-full flex justify-center text-center p-14">
        <div
          class="text-base-content max-w-xl text-pretty flex flex-col gap-10 text-lg text-shadow-sm text-shadow-base-100/10"
        >
          <h2 class="text-2xl">
            Welcome to the homepage of <br />Osaka Kyoto Technology Meetup Group
          </h2>
          <p>
            We are a vibrant community of web developers, designers, and tech enthusiasts. We meet
            regularly to share knowledge, learn new skills, and network with other professionals in
            the Kansai region.
          </p>
          <p class="font-header text-2xl">Come and join us at our next event!</p>
        </div>
      </div>
    </div>
  </Hero>

  <Section>
    <EventsUpcoming client:load events={events} />
  </Section>
  <Section
    left
    split
    title="About OKTech"
    lorem={1}
    button={{ text: "Learn More", href: "/about" }}
  >
    <ImagePlaceholder />
  </Section>

  <Section>
    <LandingStats />
  </Section>
  <Section
    inline
    wide
    grid
    class="bg-primary/20"
    title="Recent Events"
    button={{ text: "More Events", href: "/events" }}
  >
    {
      events
        .slice(5, 9)
        .map((event, i) => (
          <EventSummary class={i > 2 ? "lg:hidden xl:block" : undefined} event={event} />
        ))
    }
  </Section>

  <Section
    wide
    title="Community"
    description="Join our vibrant community of tech enthusiasts, professionals, and innovators. Connect with like-minded individuals, share knowledge, and grow together in the ever-evolving tech landscape."
  >
    <PersonAvatars people={people} />
  </Section>

  <Hero
    slim
    title="Get Involved"
    description="Ready to be part of something bigger? Whether you want to speak at our events, sponsor our initiatives, or simply join our community, we welcome your participation and ideas."
    button={{ text: "Get Involved", href: "/about#contact" }}
    class="text-lg text-center"
  />
</PageLayout>
