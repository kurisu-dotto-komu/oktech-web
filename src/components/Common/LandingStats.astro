---
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import BlobCard from "./BlobCard";

const events = await getCollection("events");
const venues = await getCollection("venues");

// Filter out dev-only events and test events for production
const realEvents = events.filter((event) => !event.data.devOnly && !event.id.startsWith("999999"));

// Calculate total events
const totalEvents = realEvents.length;

// Calculate unique locations (venues) - filter out test venues
const uniqueVenues = venues.filter((venue) => !venue.id.startsWith("999999")).length;

const stats = [
  {
    title: "First Event",
    value: "2014",
    icon: "lucide:calendar",
  },
  {
    title: "Total Events",
    value: totalEvents.toString(),
    icon: "lucide:calendar-days",
  },
  {
    title: "Locations",
    value: uniqueVenues.toString() + "+",
    icon: "lucide:map-pin",
  },
  {
    title: "Participants",
    value: "2000+",
    icon: "lucide:users",
  },
];
---

{
  stats.map((stat, index) => (
    <BlobCard client:load preset={index} className="">
      <div class="flex flex-col items-center justify-center gap-4 p-12 py-18">
        <Icon name={stat.icon} class="h-14 w-14" />
        <div class="flex flex-col items-center justify-center">
          <div class="font-header text-3xl font-bold">{stat.value}</div>
          <div class="text-sm tracking-wider whitespace-nowrap uppercase">{stat.title}</div>
        </div>
      </div>
    </BlobCard>
  ))
}
