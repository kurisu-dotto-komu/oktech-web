---
import SlideshowSimple from "@/components/Common/SlideshowSimple";
import { getImage } from "astro:assets";

// Import images directly
import img1 from "/content/events/307265699-led-and-vulnerability-disclosure/gallery/PXL_20250524_0847033052.webp";
import img2 from "/content/events/302995505-how-to-present-and-sql/gallery/DSCF0839.webp";
import img3 from "/content/events/299334647-workshop-create-a-blogportfolio-in-astro-and-hygraph/gallery/IMG_9847.webp";
import img4 from "/content/events/299335046-osaka-hanami-2024/gallery/IMG_9924.webp";
import img5 from "/content/events/299830334-vim-and-noise/gallery/IMG_20240413_1728142.webp";
import img6 from "/content/events/301456891-workshop-like-s3/gallery/IMG_7669.webp";
import img7 from "/content/events/297594896-end-of-2023-dinner/gallery/IMG_7856.webp";

const rawImages = [img1, img2, img3, img4, img5, img6, img7];

// Process all images through getImage for optimization (smaller size for about section)
const images = await Promise.all(
  rawImages.map(async (imgRaw) => {
    const optimized = await getImage({ src: imgRaw, width: 512, height: 512, format: "webp" });
    return optimized.src;
  }),
);
---

<SlideshowSimple images={images} client:load />
