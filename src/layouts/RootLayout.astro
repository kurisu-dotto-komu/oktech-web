---
import "@/styles/global.css";
import { SITE } from "@/constants";
import { resolveInternalHref } from "@/utils/urlResolver";
import SEO from "./SEO.astro";
import { ClientRouter } from "astro:transitions";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: "website" | "article" | "profile";
  article?: {
    author?: string;
    publishedTime?: string;
    modifiedTime?: string;
    tags?: string[];
  };
  noindex?: boolean;
  nofollow?: boolean;
}

const { title, ...seoProps } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="oktech-light">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=0.8, maximum-scale=0.8, user-scalable=no"
    />
    <SEO title={title} {...seoProps} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.name} - Events RSS Feed`}
      href={resolveInternalHref(`/rss.xml`)}
    />
    <script is:inline>
      // TODO enable the theme switcher?
      // const storedTheme = localStorage.getItem("theme");
      // if (storedTheme === "oktech-light" || storedTheme === "oktech-dark") {
      //   document.documentElement.setAttribute("data-theme", storedTheme);
      // } else {
      //   // Check system preference
      //   const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      //   const defaultTheme = prefersDark ? "oktech-dark" : "oktech-light";
      //   document.documentElement.setAttribute("data-theme", defaultTheme);
      //   localStorage.setItem("theme", defaultTheme);
      // }
    </script>
    <ClientRouter />
  </head>
  <body class="bg-base-100">
    <slot />
  </body>
</html>
