---
import "@/styles/global.css";
import { SITE } from "@/constants";
import { resolveInternalHref } from "@/utils/urlResolver";
import SEO from "./SEO.astro";
import { ClientRouter } from "astro:transitions";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: "website" | "article" | "profile";
  article?: {
    author?: string;
    publishedTime?: string;
    modifiedTime?: string;
    tags?: string[];
  };
  noindex?: boolean;
  nofollow?: boolean;
}

const { title, ...seoProps } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=0.8, maximum-scale=0.8, user-scalable=no"
    />
    <SEO title={title} {...seoProps} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.name} - Events RSS Feed`}
      href={resolveInternalHref(`/rss.xml`)}
    />
    <script is:inline>
      // Apply theme from localStorage or system preference
      function applyTheme() {
        const storedTheme = localStorage.getItem("theme");
        if (storedTheme === "light" || storedTheme === "dark") {
          document.documentElement.setAttribute("data-theme", storedTheme);
        } else {
          // Check system preference
          const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          const defaultTheme = prefersDark ? "dark" : "light";
          document.documentElement.setAttribute("data-theme", defaultTheme);
          localStorage.setItem("theme", defaultTheme);
        }
      }

      // Apply theme immediately
      applyTheme();

      // Reapply theme after Astro page swaps
      document.addEventListener("astro:after-swap", applyTheme);

      // TODO clean this up...
      // Track navigation direction for view transitions
      document.addEventListener("astro:before-preparation", (e) => {
        const currentPath = window.location.pathname;
        const newPath = e.to.pathname;

        // Remove base path if it exists
        const basePath = document.querySelector("base")?.getAttribute("href") || "";
        const cleanCurrentPath = currentPath.replace(basePath, "").replace(/\/$/, "") || "/";
        const cleanNewPath = newPath.replace(basePath, "").replace(/\/$/, "") || "/";

        // Check if we're on an event detail page
        const isOnEventPage = /^\/event\/[^\/]+$/.test(cleanCurrentPath);
        const isGoingToEventPage = /^\/event\/[^\/]+$/.test(cleanNewPath);
        const isGoingToHome = cleanNewPath === "/" || cleanNewPath === "";
        const isGoingToEvents = cleanNewPath.includes("/events");

        // Determine navigation direction
        if (!isOnEventPage && isGoingToEventPage) {
          // Going TO an event page from somewhere else - forward
          document.documentElement.setAttribute("data-nav-direction", "forward");
        } else if (isOnEventPage && (isGoingToHome || isGoingToEvents)) {
          // Going FROM an event page to home or events - backward
          document.documentElement.setAttribute("data-nav-direction", "backward");

          // Also disable view-transition-name on all event images to prevent transition
          document
            .querySelectorAll('img[style*="view-transition-name: event-image"]')
            .forEach((img) => {
              img.style.viewTransitionName = "none";
            });
        } else {
          // Any other navigation - no transition
          document.documentElement.removeAttribute("data-nav-direction");
        }
      });

      // Clean up after transition completes
      document.addEventListener("astro:after-swap", () => {
        // Small delay to ensure transition has completed
        setTimeout(() => {
          document.documentElement.removeAttribute("data-nav-direction");
        }, 100);
      });
    </script>
    <ClientRouter />
  </head>
  <body class="bg-base-100">
    <slot />
  </body>
</html>
