---
import "@/styles/global.css";
import { SITE } from "@/constants";
import { resolveInternalHref } from "@/utils/urlResolver";
import SEO from "./SEO.astro";
import { Font } from 'astro:assets';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: "website" | "article" | "profile";
  article?: {
    author?: string;
    publishedTime?: string;
    modifiedTime?: string;
    tags?: string[];
  };
  noindex?: boolean;
  nofollow?: boolean;
}

const { title, ...seoProps } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=0.8, maximum-scale=0.8, user-scalable=no"
    />
    <SEO title={title} {...seoProps} />
    <Font cssVariable="--font-body" />
    <Font cssVariable="--font-header" />
    <Font cssVariable="--font-mono" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.name} - Events RSS Feed`}
      href={resolveInternalHref(`/rss.xml`)}
    />
    <link
      rel="alternate"
      type="text/calendar"
      title={`${SITE.name} - Events Calendar Feed`}
      href={resolveInternalHref(`/oktech-events.ics`)}
    />
    <script is:inline>
      // Apply theme from localStorage or system preference
      function applyTheme() {
        const storedTheme = localStorage.getItem("theme");
        if (storedTheme === "light" || storedTheme === "dark") {
          document.documentElement.setAttribute("data-theme", storedTheme);
        } else {
          // Check system preference
          const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          const defaultTheme = prefersDark ? "dark" : "light";
          document.documentElement.setAttribute("data-theme", defaultTheme);
          localStorage.setItem("theme", defaultTheme);
        }
      }

      // Apply theme immediately
      applyTheme();
    </script>
  </head>
  <body class="bg-base-100">
    <slot />
  </body>
</html>
