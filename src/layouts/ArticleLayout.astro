---
import PageLayout from "@/layouts/PageLayout.astro";
import Link from "@/components/Common/LinkAstro.astro";
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
  pageTitle?: string;
  buttons?: Array<{
    href: string;
    icon: string;
    value: string;
    title?: string;
  }>;
  active?: string;
  class?: string;
}

const { title, pageTitle, buttons, active, class: className } = Astro.props;
const hasHeaderSlot = Astro.slots.has("header");
---

<PageLayout title={pageTitle || title}>
  <section class={`py-18 ${className || ""}`}>
    <div class="mx-auto w-full max-w-6xl px-4 md:px-6 lg:px-8">
      <div class="mb-8 flex items-center justify-between">
        <h1 class="text-5xl font-bold">{title}</h1>
        {hasHeaderSlot && <slot name="header" />}
        {
          !hasHeaderSlot && buttons && active && (
            <div class="join">
              {buttons.map((button) => (
                <Link
                  href={button.href}
                  class={`btn join-item ${active === button.value ? "btn-active" : ""}`}
                  title={button.title || button.value}
                >
                  <Icon name={button.icon} size={20} />
                </Link>
              ))}
            </div>
          )
        }
      </div>
    </div>
    <div class="mx-auto w-full max-w-6xl px-4 md:px-6 lg:px-8">
      <slot />
    </div>
  </section>
</PageLayout>
