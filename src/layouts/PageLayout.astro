---
import RootLayout from "./RootLayout.astro";
import TopBar from "@/components/Common/TopBar";
import Footer from "@/components/Common/Footer";

const { subtleNavbar, ...rest } = Astro.props;
---

<RootLayout {...rest}>
  <div class="flex min-h-screen flex-col">
    <header>
      <TopBar client:load subtle={subtleNavbar} />
    </header>
    <!-- mt-16 for sticky header -->
    <main class={`bg-base-300 flex-1 ${subtleNavbar ? "" : "pt-16"}`}>
      <slot />
    </main>
    <footer>
      <Footer client:load />
    </footer>
  </div>
  <!-- <DevInfo client:load /> -->
</RootLayout>
