---
import RootLayout from "./RootLayout.astro";
import TopBar from "@/components/Common/TopBar";
import Footer from "@/components/Common/Footer";
import DevInfo from "@/components/Common/DevInfo.tsx";
---

<RootLayout {...Astro.props}>
  <div class="min-h-screen flex flex-col max-w-screen overflow-x-hidden">
    <header>
      <TopBar client:load />
    </header>
    <!-- mt-16 for sticky header -->
    <main class="flex-1 mt-16 bg-base-300">
      <slot />
    </main>
    <footer>
      <Footer client:load />
    </footer>
  </div>
  <!-- <DevInfo client:load /> -->
</RootLayout>
